# ChatGPT Gateway configuration example
# Copy this file to ".env" and edit the values you need.
#   Windows:  copy example.env .env
#   Linux:    cp example.env .env
#
# NOTE: Node does not load .env automatically. Start the server with:
#   node --env-file=.env server.js
# or set the variables in your shell/PowerShell before running "npm start".

# Port the web UI and API listen on
PORT=3000

# Set to 1 to show the browser window (useful for solving a captcha once)
HEADED=0

# Chromium profile directory (persists cookies/session)
PROFILE=./profile

# Max ms to wait for a response before timing out
TIMEOUT=300000

# Where the current conversation URL is remembered
STATE_FILE=./state.json

# Where saved chat transcripts are stored
CHATS_FILE=./chats.json

# Where settings (system prompt) are stored
SETTINGS_FILE=./settings.json

# Set to 1 to skip auto-opening the browser on start
NO_BROWSER=0

# Address to bind to: 0.0.0.0 = whole LAN, 127.0.0.1 = this PC only
HOST=0.0.0.0

# Master token. Set this to enable login + auth for all /api routes.
# The UI then shows a login screen where accounts can be created.
# AUTH_TOKEN=change-me

# Set to 0 to disable self-registration (accounts then need the master token via /api/register)
ALLOW_SIGNUP=1

# Optional secret: if set, chats.json and settings.json are encrypted at rest (AES-256-GCM)
# ENCRYPT_KEY=long random phrase

# Set to 0 to disable the GitHub update check
UPDATE_CHECK=1

# Set to 1 to also serve HTTPS (port PORT+1) with an auto-generated self-signed
# certificate. The mic (voice input) needs a secure page — this enables voice on
# your LAN. On Windows the certificate is auto-trusted in your user store.
# HTTPS=1

# Max characters for one message (ChatGPT guest mode context ceiling is ~128k
# tokens, about 500k characters). Lower it if ChatGPT rejects big messages.
# MAX_PROMPT=500000
