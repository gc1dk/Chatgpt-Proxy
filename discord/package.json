{
  "name": "chatgpt-gateway-discord-bot",
  "version": "1.0.0",
  "description": "Free Discord bot powered by the ChatGPT Gateway (no API keys). Chat, voice (speak + listen), auto-moderation, personas, verification.",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "check": "node --check bot.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "ffmpeg-static": "^5.2.0",
    "node-edge-tts": "^1.2.10",
    "opusscript": "^0.0.8",
    "unzipper": "^0.12.0",
    "vosk": "^0.3.39",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "@discordjs/opus": true,
    "ffmpeg-static": true,
    "ffi-napi": true,
    "ref-napi": true
  }
}
